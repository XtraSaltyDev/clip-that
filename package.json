{
  "name": "clipthat",
  "version": "0.1.18",
  "description": "ClipThat — privacy-first local screen capture, annotation and recording",
  "main": "./out/main/index.js",
  "author": "ClipThat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XtraSaltyDev/clip-that.git"
  },
  "bugs": {
    "url": "https://github.com/XtraSaltyDev/clip-that/issues"
  },
  "homepage": "https://github.com/XtraSaltyDev/clip-that#readme",
  "private": true,
  "scripts": {
    "predev": "npm run build:native",
    "dev": "electron-vite dev",
    "prestart": "npm run build:native",
    "start": "electron-vite preview",
    "build": "npm run build:native && npm run verify:third-party && npm run quality && npm run typecheck && npm test && electron-vite build",
    "build:native": "node scripts/build-window-info-helper.mjs",
    "build:ffmpeg:mac": "bash scripts/build-ffmpeg-mac.sh",
    "build:ffmpeg:win": "bash scripts/build-ffmpeg-win.sh",
    "verify:ocr-assets": "node scripts/verify-ocr-assets.mjs --source",
    "verify:js-licenses": "node scripts/verify-js-licenses.mjs --source",
    "verify:third-party": "npm run verify:ocr-assets && npm run verify:js-licenses",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"require('node:fs').rmSync('.cache/test',{recursive:true,force:true})\" && tsc -p tsconfig.tests.json && node --test \"tests/*.test.mjs\"",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"package.json\" \"eslint.config.mjs\" \".prettierrc.json\" \"src/main/log.ts\" \"src/main/ocr.ts\" \"src/main/recording/ffmpeg.ts\" \"src/main/store/settings.ts\" \"src/main/update/service.ts\" \"src/main/windows/manager.ts\" \"src/renderer/editor/App.tsx\" \"src/renderer/editor/layout.ts\" \"src/renderer/editor/VideoEditor.tsx\" \"src/renderer/editor/canvas/LineControls.tsx\" \"src/renderer/editor/canvas/annotation-bounds.ts\" \"src/renderer/editor/canvas/Shapes.tsx\" \"src/renderer/editor/canvas/Stage.tsx\" \"src/renderer/editor/canvas/geometry.ts\" \"src/renderer/editor/canvas/direct-gesture.ts\" \"src/renderer/editor/canvas/rotation-handle.ts\" \"src/renderer/editor/canvas/transforms.ts\" \"src/renderer/editor/canvas/use-rotate-handle.ts\" \"src/renderer/hud/Recorder.tsx\" \"src/renderer/overlay/Overlay.tsx\" \"src/renderer/settings/App.tsx\" \"src/shared/defaults.ts\" \"src/shared/release-notes.ts\"",
    "format:check:release": "prettier --check \"tsconfig.tests.json\" \".github/workflows/ci.yml\" \".github/workflows/windows-candidate.yml\" \"electron-builder.yml\" \"docs/windows-11-x64-acceptance-v1.md\" \"src/main/capture/backend.ts\" \"src/main/capture/failures.ts\" \"src/main/capture/geometry.ts\" \"src/main/diagnostics/export.ts\" \"src/main/ipc/handlers.ts\" \"src/main/ipc/validation.ts\" \"src/main/recording/ffmpeg-errors.ts\" \"src/main/recording/ffmpeg-path.ts\" \"src/main/recording/ffmpeg.ts\" \"src/main/recording/session.ts\" \"src/main/recording/state.ts\" \"src/preload/index.ts\" \"src/renderer/editor/clipboard-intent.ts\" \"src/renderer/editor/commands.ts\" \"src/renderer/hud/pipeline.ts\" \"src/renderer/hud/recording-sources.ts\" \"src/renderer/shared/platform.ts\" \"src/shared/ipc.ts\" \"src/shared/platform-capabilities.ts\" \"src/shared/types.ts\" \"tests/*.mjs\" \"tests/fakes/*.mjs\"",
    "format": "prettier --write \"package.json\" \"eslint.config.mjs\" \".prettierrc.json\" \"src/main/log.ts\" \"src/main/ocr.ts\" \"src/main/recording/ffmpeg.ts\" \"src/main/store/settings.ts\" \"src/main/update/service.ts\" \"src/main/windows/manager.ts\" \"src/renderer/editor/App.tsx\" \"src/renderer/editor/layout.ts\" \"src/renderer/editor/VideoEditor.tsx\" \"src/renderer/editor/canvas/LineControls.tsx\" \"src/renderer/editor/canvas/annotation-bounds.ts\" \"src/renderer/editor/canvas/Shapes.tsx\" \"src/renderer/editor/canvas/Stage.tsx\" \"src/renderer/editor/canvas/geometry.ts\" \"src/renderer/editor/canvas/direct-gesture.ts\" \"src/renderer/editor/canvas/rotation-handle.ts\" \"src/renderer/editor/canvas/transforms.ts\" \"src/renderer/editor/canvas/use-rotate-handle.ts\" \"src/renderer/hud/Recorder.tsx\" \"src/renderer/overlay/Overlay.tsx\" \"src/renderer/settings/App.tsx\" \"src/shared/defaults.ts\" \"src/shared/release-notes.ts\"",
    "quality": "npm run lint && npm run format:check && npm run format:check:release",
    "postinstall": "electron-builder install-app-deps",
    "prebuild:mac": "npm run build:ffmpeg:mac",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "release:mac": "bash scripts/release-mac.sh",
    "release:publish:mac": "bash scripts/publish-mac-release.sh",
    "release:verify:mac": "bash scripts/verify-mac-release.sh",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -mwl",
    "extract-check": "node scripts/extract-check.mjs",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "konva": "^9.3.16",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tesseract.js": "5.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.2"
  }
}
