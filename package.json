{
  "name": "clipthat",
  "version": "1.0.0",
  "description": "ClipThat — modern cross-platform screen capture, annotation and recording",
  "main": "./out/main/index.js",
  "author": "ClipThat",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -mwl",
    "visual-check": "CLIPTHAT_VISUAL_CHECK=${DIR:-/tmp/clipthat-shots} electron-vite dev",
    "extract-check": "node scripts/extract-check.mjs",
    "test": "node scripts/build-tests.mjs && node --test \"tests/*.test.mjs\"",
    "fixture": "node scripts/make-fixture.mjs",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
