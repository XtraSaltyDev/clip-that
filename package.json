{
  "name": "clipthat",
  "version": "0.1.10",
  "description": "ClipThat — private screen capture, annotation and recording for macOS",
  "main": "./out/main/index.js",
  "author": "ClipThat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XtraSaltyDev/clip-that.git"
  },
  "bugs": {
    "url": "https://github.com/XtraSaltyDev/clip-that/issues"
  },
  "homepage": "https://github.com/XtraSaltyDev/clip-that#readme",
  "private": true,
  "scripts": {
    "predev": "npm run build:native",
    "dev": "electron-vite dev",
    "prestart": "npm run build:native",
    "start": "electron-vite preview",
    "build": "npm run build:native && npm run quality && npm run typecheck && npm run test && electron-vite build",
    "build:native": "node scripts/build-window-info-helper.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"package.json\" \"eslint.config.mjs\" \".prettierrc.json\" \"scripts/build-tests.mjs\" \"src/main/dev/self-test.ts\" \"src/main/dev/self-test-exit.ts\" \"src/main/dev/editor-self-test.ts\" \"src/main/log.ts\" \"src/main/ocr.ts\" \"src/main/recording/ffmpeg.ts\" \"src/main/store/settings.ts\" \"src/main/update/service.ts\" \"src/main/windows/manager.ts\" \"src/renderer/editor/App.tsx\" \"src/renderer/editor/self-test-bridge.ts\" \"src/renderer/editor/layout.ts\" \"src/renderer/editor/VideoEditor.tsx\" \"src/renderer/editor/exporting-test-entry.ts\" \"src/renderer/editor/canvas/LineControls.tsx\" \"src/renderer/editor/canvas/annotation-bounds.ts\" \"src/renderer/editor/canvas/Shapes.tsx\" \"src/renderer/editor/canvas/Stage.tsx\" \"src/renderer/editor/canvas/geometry.ts\" \"src/renderer/editor/canvas/direct-gesture.ts\" \"src/renderer/editor/canvas/rotation-handle.ts\" \"src/renderer/editor/canvas/transforms.ts\" \"src/renderer/editor/canvas/use-rotate-handle.ts\" \"src/renderer/hud/Recorder.tsx\" \"src/renderer/overlay/Overlay.tsx\" \"src/renderer/settings/App.tsx\" \"src/shared/defaults.ts\" \"src/shared/release-notes.ts\" \"tests/filename.test.mjs\" \"tests/layout.test.mjs\" \"tests/release-notes.test.mjs\" \"tests/self-test-exit.test.mjs\" \"tests/rotation-handle.test.mjs\" \"tests/transforms.test.mjs\" \"tests/line-controls.test.mjs\"",
    "format": "prettier --write \"package.json\" \"eslint.config.mjs\" \".prettierrc.json\" \"scripts/build-tests.mjs\" \"src/main/dev/self-test.ts\" \"src/main/dev/self-test-exit.ts\" \"src/main/dev/editor-self-test.ts\" \"src/main/log.ts\" \"src/main/ocr.ts\" \"src/main/recording/ffmpeg.ts\" \"src/main/store/settings.ts\" \"src/main/update/service.ts\" \"src/main/windows/manager.ts\" \"src/renderer/editor/App.tsx\" \"src/renderer/editor/self-test-bridge.ts\" \"src/renderer/editor/layout.ts\" \"src/renderer/editor/VideoEditor.tsx\" \"src/renderer/editor/exporting-test-entry.ts\" \"src/renderer/editor/canvas/LineControls.tsx\" \"src/renderer/editor/canvas/annotation-bounds.ts\" \"src/renderer/editor/canvas/Shapes.tsx\" \"src/renderer/editor/canvas/Stage.tsx\" \"src/renderer/editor/canvas/geometry.ts\" \"src/renderer/editor/canvas/direct-gesture.ts\" \"src/renderer/editor/canvas/rotation-handle.ts\" \"src/renderer/editor/canvas/transforms.ts\" \"src/renderer/editor/canvas/use-rotate-handle.ts\" \"src/renderer/hud/Recorder.tsx\" \"src/renderer/overlay/Overlay.tsx\" \"src/renderer/settings/App.tsx\" \"src/shared/defaults.ts\" \"src/shared/release-notes.ts\" \"tests/filename.test.mjs\" \"tests/layout.test.mjs\" \"tests/release-notes.test.mjs\" \"tests/self-test-exit.test.mjs\" \"tests/rotation-handle.test.mjs\" \"tests/transforms.test.mjs\" \"tests/line-controls.test.mjs\"",
    "quality": "npm run lint && npm run format:check",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "release:mac": "bash scripts/release-mac.sh",
    "release:publish:mac": "bash scripts/publish-mac-release.sh",
    "release:publish:spark": "bash scripts/publish-spark-release.sh",
    "release:verify:mac": "bash scripts/verify-mac-release.sh",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -mwl",
    "visual-check": "CLIPTHAT_VISUAL_CHECK=${DIR:-/tmp/clipthat-shots} electron-vite dev",
    "extract-check": "node scripts/extract-check.mjs",
    "test": "node scripts/build-tests.mjs && node --test \"tests/*.test.mjs\"",
    "fixture": "node scripts/make-fixture.mjs",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "electron-updater": "6.8.9",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "konva": "^9.3.16",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.2"
  }
}
